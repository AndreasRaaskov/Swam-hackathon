# Copy to .env and fill in. Never commit .env; it is excluded from the Docker image.
# Adaption (open-weight models via Adaption's own SDK; uses its default endpoint)
ADAPTION_API_KEY=
# Optional: only set to override Adaption's endpoint (leave out otherwise)
# ADAPTION_BASE_URL=
# Anthropic (optional judge / Claude targets)
ANTHROPIC_API_KEY=
# Optional path overrides (defaults: ./data ./outputs ./config ; in Docker: /data /outputs /config)
# JOURAPIST_DATA=
# JOURAPIST_OUTPUTS=
# JOURAPIST_CONFIG=
# Kai's swarmbox interrogation API (`jourapist swarmbox ...`): your personal Cloudflare Access service token,
# shown after logging in at the swarmbox URL. Calls are logged under your name.
# SWARMBOX_URL=https://swarm-audit.kaiel.vin
SWARMBOX_CF_CLIENT_ID=
SWARMBOX_CF_CLIENT_SECRET=
